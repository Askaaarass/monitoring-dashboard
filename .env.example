DJANGO_SECRET_KEY=replace-with-a-random-secret
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_REQUEST_TIMEOUT_SECONDS=25
GEMINI_REQUESTS_PER_MINUTE=10

# Keep disabled until the recipient and merchant onboarding are verified.
DONATIONS_ENABLED=false
PAYMENT_PROVIDER_CLASS=
# Add only the exact HTTPS checkout hostname after verifying the provider.
# PAYMENT_CHECKOUT_ALLOWED_HOSTS=checkout.example.kz
# Set to the canonical HTTPS origin; payments remain unavailable without it.
PUBLIC_SITE_URL=
